# Copy to .env and paste your key. .env is gitignored — never commit it.
#
# main uses Gemini as the primary aggregator, with the free keyless sources
# (Billboard / World Bank / Open Trivia DB) as automatic fallback. So an edition
# still builds WITHOUT any key — it just uses the free sources until a key is set.
#
# Gemini's Google-Search grounding needs a BILLING-ENABLED Google project (it
# stays ~$0 under the free grounded-query allotment). Get a key at:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# HLQ_GEMINI_MODEL=gemini-3.6-flash
# HLQ_AGGREGATOR=gemini        # or "free" to skip the LLM and use free sources only
#
# Groq is also wired but its Compound web search needs the paid Dev tier:
# GROQ_API_KEY=
# HLQ_GROQ_MODEL=groq/compound
